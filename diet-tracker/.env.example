# העתק ל-.env ומלא. הקובץ .env לא נכנס ל-Git.
COMPOSE_PROJECT_NAME=diet-tracker

# סיסמת הכניסה לאפליקציה (מגובבת ב-bcrypt בעלייה, לא נשמרת בטקסט גלוי בזיכרון).
# להשאיר ריק = בלי סיסמה בכלל; הגישה מוגבלת רק למכשירים ב-tailnet שלך.
APP_PASSWORD=
# אלטרנטיבה מומלצת: hash מוכן (ראה RUNBOOK). אם מוגדר — APP_PASSWORD מתעלמים ממנו.
# שים לב: לעטוף במרכאות בודדות כדי ש-Compose לא יפרש את ה-$, למשל: APP_PASSWORD_HASH='$2b$12$...'
APP_PASSWORD_HASH=

# Auth key מה-Tailscale admin console (Reusable: לא, Ephemeral: לא).
TS_AUTHKEY=
# אופציונלי, למשל: --advertise-tags=tag:diet-tracker
TS_EXTRA_ARGS=
